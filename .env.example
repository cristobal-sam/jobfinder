# Copier ce fichier en .env et remplir les valeurs.

# --- Découverte (Apify / Google Maps) ---
# Sans ce jeton, le pipeline utilise data/entreprises_test.csv
APIFY_TOKEN=

# --- Envoi Gmail ---
# Mot de passe d'application : https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=

# --- Identité insérée dans les messages ---
SENDER_SIGNATURE=Prénom Nom\n000 000-0000 · linkedin.com/in/votre-profil
SENDER_PRESENTATION=Je suis à la recherche d'une opportunité en cybersécurité et je serais heureux de vous présenter mon profil.

# --- LLM local (optionnel) ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELE=qwen2.5:7b

# --- Limites et politesse ---
DAILY_LIMIT=5
REQUEST_DELAY=2
USER_AGENT=prospect-qc/0.1
